{
  "manifest_version": 2,
  "name": "Steam PricePerHour",
  "version": "1.3.2",
  "description": "Smart value insights for Steam: shows price/hour ratio badges across search, home, sale pages, bundles, and individual game pages. Supports all Steam currencies.",
  "icons": {
    "16": "image.png",
    "48": "image.png",
    "128": "image.png"
  },
  "applications": {
    "gecko": {
      "id": "steam-priceperhour@vintlgvard.com",
      "strict_min_version": "57.0"
    }
  },
  "background": {
    "scripts": ["service_worker.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Steam PricePerHour",
    "default_icon": "image.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "https://store.steampowered.com/*",
    "https://steampowered.com/*",
    "https://howlongtobeat.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://steampowered.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://howlongtobeat.com/*"
      ],
      "js": ["spph_bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
